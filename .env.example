# Copiá este archivo a .env (git lo ignora) y completá lo que uses. Nada de esto es obligatorio.

# Voces de ElevenLabs ("voice": "eleven:<voice_id>"). Podés poner la clave o apuntar a un archivo que la tenga.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_ENV_FILE=/ruta/a/otro/env.sh

# Render en la nube (Modal): cuenta de ~/.modal.toml, GPU por defecto y nube por defecto.
# VOXEL_MODAL_PROFILE=mi-perfil
# VOXEL_MODAL_GPU=L4,A10G,T4
# VOXEL_CLOUD=modal

# Ejecutables si no se detectan solos.
# BLENDER=/Applications/Blender.app/Contents/MacOS/Blender
# FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
